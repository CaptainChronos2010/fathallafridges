التعديل في صفحة الإعداد setup.html
 فقط، وأصبح في سطر واحد واضح:

السطر 203:

js


/* النص الإرشادي داخل خانة رمز الثلاجة — غيّره كما تريد */
const CODE_PLACEHOLDER = 'رمز الثلاجة (R1)';
غيّر النص الذي بين علامتي التنصيص '...' فقط، مع الحفاظ على العلامتين والفاصلة المنقوطة. أمثلة:

js


const CODE_PLACEHOLDER = 'أدخل رمز الثلاجة';
const CODE_PLACEHOLDER = 'كود الثلاجة';
const CODE_PLACEHOLDER = 'مثال: F1';
أو احذف الدالة كلها إن لم ترد أي نص إرشادي:

js


const CODE_PLACEHOLDER = '';

-----------------------------


ثالثًا: الحدود والخيارات في الكود — أين بالضبط
كلها في أعلى index.html
 داخل <script>:

١) الحد الأقصى (هو الذي يُشغّل الإنذار) — السطر 340
js


const ALARM_ABOVE = {
  'تبريد': 8,     // التبريد: أعلى من ٨° يدل على وجود مشكلة
  'تجميد': -15    // التجميد: أعلى من −١٥° يدل على عدم كفاية التبريد
};
القاعدة: إنذار عندما تكون القراءة أعلى من الرقم فقط.

النوع	الحد	نتيجة سليمة	نتيجة تُنذر
تبريد	8	٦ أو ٨	٩ أو ١٠
تجميد	−15	−18 أو −15	−14 أو −10
لتغيير الحد: عدّل الرقم فقط.
لإلغاء الإنذار عن نوع: احذف سطره.
٢) خيارات الحالة — السطر 330
js


const STATUSES = [
  { key: 'ok',    label: 'سليم',        tone: 'ok',   needsTemp: true  },
  { key: 'fault', label: 'به عطل',      tone: 'bad',  needsTemp: true  },
  { key: 'maint', label: 'تحت الصيانة', tone: 'warn', needsTemp: false }
];
الخيار	ما يعنيه
label	النص الظاهر على الزر
tone	اللون: ok أخضر، warn أصفر، bad أحمر، info أزرق
needsTemp	true = إلزامي إدخال درجة حرارة، false = اختياري
الإنذار لا علاقة له بالحالة: يُحسب فقط من (نوع الثلاجة + الرقم). والحالة لا تمنع الحفظ.
